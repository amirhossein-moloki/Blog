# ==============================================================================
#                 ENTERPRISE BLOG CMS - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to '.env' and configure according to your environment.
# Note: Do not commit your active '.env' file containing secrets to version control.

# ------------------------------------------------------------------------------
# 1. Django Core Settings
# ------------------------------------------------------------------------------
# EN: Security key for cryptographic signing. Generate a strong random key in production.
# FA: کلید امنیتی برای امضای رمزنگاری. در محیط پروداکشن یک کلید قوی و تصادفی تولید کنید.
SECRET_KEY=replace-this-with-a-very-secret-key-1234567890

# EN: Set to False in production. True enables verbose error pages and interactive debugger.
# FA: در محیط عملیاتی (production) برابر با False قرار دهید. مقدار True صفحات خطای دقیق را فعال می‌کند.
DEBUG=True

# EN: Primary domain name under which the application is served.
# FA: دامنه اصلی که اپلیکیشن تحت آن سرویس‌دهی می‌کند.
DOMAIN=localhost

# EN: Comma-separated list of host/domain names that this Django site can serve.
# FA: لیست جدا شده با کاما از نام‌های میزبان/دامنه که این سایت جنگو می‌تواند به آن‌ها پاسخ دهد.
ALLOWED_HOSTS=localhost,127.0.0.1

# EN: Site name displayed in the administrator panel and email footers.
# FA: نام سایت که در پنل مدیریت و فوتر ایمیل‌ها نمایش داده می‌شود.
SITE_NAME=Blog Platform

# EN: Fully qualified URL to the frontend application for CORS, templates, and redirect mapping.
# FA: آدرس کامل اپلیکیشن فرانت‌اند برای CORS، قالب‌ها و ریدایرکت‌ها.
FRONTEND_URL=http://localhost:3000

# EN: Secret static API Key for automated SRE, integrations, and external client authentication.
# FA: کلید استاتیک امن برای احراز هویت سرویس‌های خارجی، سیستم‌های SRE و ادغام‌ها.
STATIC_API_KEY=your-secure-static-api-key-here-min-32-chars

# ------------------------------------------------------------------------------
# 2. Database Settings (PostgreSQL or SQLite)
# ------------------------------------------------------------------------------
# EN: DATABASE_URL takes precedence over individual POSTGRES_* settings if set.
#     Format: postgres://user:password@host:port/dbname
# FA: در صورت تنظیم، DATABASE_URL بر سایر تنظیمات POSTGRES_* اولویت خواهد داشت.
DATABASE_URL=postgres://db_user:db_password@db:5432/blog_db

# Individual Postgres Settings (used for Docker Compose database service initialization)
POSTGRES_DB=blog_db
POSTGRES_USER=db_user
POSTGRES_PASSWORD=db_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 3. Enterprise Caching & Redis Settings
# ------------------------------------------------------------------------------
# EN: Toggle using Redis as the central caching, channels, and session store backend.
#     If False, system falls back to thread-safe LocMemCache and local memory.
# FA: فعال/غیرفعال کردن استفاده از Redis برای کش، چنل‌ها و سشن‌ها.
#     در صورت False بودن، سیستم به LocMemCache محلی سوئیچ می‌کند.
USE_REDIS=False

# EN: Full Redis connection string (e.g., redis://host:port/db_number).
# FA: رشته اتصال کامل به سرور ردیس.
REDIS_URL=redis://cache:6379/0

# ------------------------------------------------------------------------------
# 4. Celery and Task Queue Settings
# ------------------------------------------------------------------------------
# EN: Max tasks a worker process can complete before recycling (prevents memory leaks).
# FA: حداکثر تعداد تسک‌هایی که یک پروسس ورکر قبل از بازسازی می‌تواند انجام دهد تا از نشت حافظه جلوگیری شود.
CELERY_WORKER_MAX_TASKS_PER_CHILD=100

# EN: Time thresholds (seconds) for running tasks before triggering warnings or execution termination.
# FA: آستانه زمان (ثانیه) برای اجرای تسک‌ها قبل از ارسال اخطار یا قطع فرآیند اجرا.
CELERY_TASK_SOFT_TIME_LIMIT=900
CELERY_TASK_TIME_LIMIT=960
CELERY_VISIBILITY_TIMEOUT=1200
CELERY_RESULT_EXPIRES_HOURS=24

# ------------------------------------------------------------------------------
# 5. Media & Cloud Storage Settings
# ------------------------------------------------------------------------------
# EN: STORAGE_BACKEND can be 'local' (local filesystem) or 's3' (S3-compatible cloud bucket).
# FA: محل ذخیره‌سازی فایل‌ها که می‌تواند 'local' (سیستم فایل محلی) یا 's3' (ابری سازگار با S3) باشد.
STORAGE_BACKEND=local

# EN: URL path prefix for accessing uploaded media assets.
# FA: پیشوند آدرس وب برای دسترسی به فایل‌های رسانه‌ای آپلود شده.
MEDIA_URL=/media/

# S3 Configuration parameters (Required if STORAGE_BACKEND=s3 or BDR backup off-site is active)
AWS_ACCESS_KEY_ID=your-s3-access-key-id
AWS_SECRET_ACCESS_KEY=your-s3-secret-key
AWS_STORAGE_BUCKET_NAME=your-s3-bucket-name
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=https://s3.parspack.com
AWS_S3_CUSTOM_DOMAIN=

# ------------------------------------------------------------------------------
# 6. Enterprise Backup & Disaster Recovery (BDR) Subsystem Settings
# ------------------------------------------------------------------------------
# EN: Local absolute path where database, media, and configuration backups are saved.
# FA: مسیر محلی مطلق که فایل‌های پشتیبان پایگاه داده، رسانه و تنظیمات در آن ذخیره می‌شوند.
BACKUP_DIR=/app/backups

# EN: Simple retention backup window in days.
# FA: دوره نگهداری پشتیبان‌های محلی بر حسب روز.
BACKUP_RETENTION_DAYS=7

# EN: Target storage engines for backups. Options: 'local', 's3', or comma-separated 'local,s3'.
# FA: موتورهای ذخیره‌سازی هدف برای پشتیبان‌گیری: 'local' یا 's3' یا 'local,s3'.
BACKUP_STORAGE=local

# EN: Enable streaming AES-256-GCM encryption on database and config backups (highly recommended).
# FA: فعال‌سازی رمزگذاری جریانی AES-256-GCM روی پشتیبان‌های پایگاه داده و تنظیمات (به شدت توصیه می‌شود).
BACKUP_ENCRYPT=False

# EN: Extremely strong symmetric key/passphrase for PBKDF2 HMAC-SHA256 key derivation.
# FA: کلید متقارن بسیار قوی برای اشتقاق کلید رمزنگاری PBKDF2.
BACKUP_ENCRYPTION_KEY=change-this-to-a-secure-passphrase-with-high-entropy

# EN: Enables/disables pushing local backups to secure off-site cloud storage (S3).
# FA: فعال/غیرفعال کردن ارسال پشتیبان‌های محلی به فضای ذخیره‌سازی ابری خارج از سایت (S3).
BACKUP_OFFSITE_ENABLED=False

# EN: If True (mandatory in Production), failure to upload to S3 triggers a critical application error state.
# FA: در صورت True بودن، هرگونه خطا در آپلود به S3 یک خطای بحرانی در اپلیکیشن ایجاد می‌کند (الزامی در پروداکشن).
BACKUP_OFFSITE_REQUIRED=False

# ------------------------------------------------------------------------------
# 7. Email Configuration
# ------------------------------------------------------------------------------
# EN: Email Backend: 'django.core.mail.backends.console.EmailBackend' (Development)
#                 or 'django.core.mail.backends.smtp.EmailBackend' (Production)
# FA: بک‌اند ایمیل: خروجی کنسول برای توسعه یا SMTP برای پروداکشن.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=webmaster@localhost
EMAIL=admin@example.com

# ------------------------------------------------------------------------------
# 8. Security, CORS & CSRF Settings
# ------------------------------------------------------------------------------
# EN: Comma-separated list of trusted origins for Cross-Origin Resource Sharing (CORS).
# FA: لیست جدا شده با کاما از مبداهای مورد اعتماد برای CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# EN: Bypass origin check for development environments only. Never set to True in production!
# FA: دور زدن بررسی مبدا برای محیط‌های توسعه. هرگز در پروداکشن True نگذارید!
CORS_ALLOW_ALL_ORIGINS=False

# EN: Comma-separated list of origins trusted to send POST/PUT requests (CSRF protection).
# FA: لیست جدا شده با کاما از مبداهای مجاز برای ارسال درخواست‌های امنیتی CSRF.
CSRF_TRUSTED_ORIGINS=http://localhost:3000
